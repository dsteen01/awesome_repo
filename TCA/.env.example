# Copy this file to .env and fill in your values.
# .env must be listed in .gitignore — never commit real credentials.
#
# Load in Python with:
#   from dotenv import load_dotenv; load_dotenv()
# Or set these as shell / CI environment variables directly.

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com        # or smtp.office365.com, your internal relay, etc.
SMTP_PORT=587                   # 587 = STARTTLS (default), 465 = SSL
SMTP_USER=reports@yourfirm.com
SMTP_PASSWORD=your_app_password_here

# Optional: display name in the From field (defaults to SMTP_USER if omitted)
EMAIL_FROM=TCA Reports <reports@yourfirm.com>
